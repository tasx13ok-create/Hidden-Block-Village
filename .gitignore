# Local build and dependency output
.gradle/
**/build/
**/target/
/out/
/dist/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.class

# Runtime distributions and large archives belong outside Git
*.jar
*.zip
*.zip.*
*.7z
*.rar
*.tar
*.tar.*
*.gz
*.part
*.part[0-9]*
*.partial
*.partial.*

# Preserve a conventional checked-in Gradle wrapper when source review permits it
!**/gradle/wrapper/gradle-wrapper.jar

# Local instances, saves, rollback data, and unpublished recovery material
/runtime/
/instances/
/staging/
/local/
/private/
/backups/
/downloads/
/exports/
/preview-worlds/
/reference-content*/
/decompiled/
/evidence/private/
/world/
/Naruto.test/
**/saves/
**/playerdata/
*.mca
level.dat
level.dat_old
session.lock
usercache.json
ops.json
whitelist.json
banned-players.json
banned-ips.json
server.properties

# Local credentials and host configuration; commit reviewed examples only
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
credentials.json
tokens.json

# Local logs and editor state
*.log
logs/
crash-reports/
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
